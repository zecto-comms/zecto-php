{
    "name": "zecto/sdk",
    "description": "Official PHP SDK for the Zecto multi-channel messaging platform",
    "type": "library",
    "license": "MIT",
    "keywords": ["zecto", "messaging", "messaging-api", "sdk", "api-client", "whatsapp"],
    "homepage": "https://zecto.io",
    "authors": [
        {
            "name": "Zecto",
            "homepage": "https://zecto.io"
        }
    ],
    "support": {
        "issues": "https://github.com/zecto-comms/zecto-php/issues",
        "source": "https://github.com/zecto-comms/zecto-php"
    },
    "require": {
        "php": ">=8.1",
        "guzzlehttp/guzzle": "^7.5"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5"
    },
    "autoload": {
        "psr-4": {
            "Zecto\\": "src/"
        }
    },
    "minimum-stability": "stable"
}
